// -------------------- UTILITÁRIOS -----------------------------
String sanitizeCsvField(String s) {
  s.trim();
  s.replace(",", "-");
  s.replace("\n", " ");
  s.replace("\r", " ");
  if (s.length() == 0) s = "Ponto";
  if (s.length() > 24) s = s.substring(0, 24);
  return s;
}

String jsonEscape(String s) {
  s.replace("\\", "\\\\");
  s.replace("\"", "\\\"");
  s.replace("\n", "\\n");
  s.replace("\r", "");
  return s;
}

float randomFloat(float minValue, float maxValue, int decimals = 1) {
  long scale = 1;
  for (int i = 0; i < decimals; i++) scale *= 10;
  long minScaled = (long)(minValue * scale);
  long maxScaled = (long)(maxValue * scale);
  return random(minScaled, maxScaled + 1) / (float)scale;
}

uint64_t currentEpoch() {
  if (syncedEpoch == 0) return 0;
  return syncedEpoch + ((millis() - syncedAtMillis) / 1000ULL);
}

String classifySoil(const SoilAnalysis &a) {
  uint8_t ok = 0;

  // Faixas DEMONSTRATIVAS para a simulação.
  if (a.ph >= 5.5 && a.ph <= 7.2) ok++;
  if (a.ec >= 0.30 && a.ec <= 1.80) ok++;
  if (a.temperature >= 18.0 && a.temperature <= 30.0) ok++;
  if (a.moisture >= 30.0 && a.moisture <= 65.0) ok++;
  if (a.nitrogen >= 25.0) ok++;
  if (a.phosphorus >= 12.0) ok++;
  if (a.potassium >= 45.0) ok++;

  if (ok >= 6) return "Favorável";
  if (ok >= 4) return "Atenção";
  return "Desfavorável";
}

void ensureHistoryFile() {
  if (!LittleFS.exists(HISTORY_FILE)) {
    File f = LittleFS.open(HISTORY_FILE, FILE_WRITE);
    if (f) {
      f.println("id,epoch,ponto,ph,ec,temperatura,fosforo,potassio,umidade,nitrogenio,status");
      f.close();
    }
  }
}

void trimHistoryIfNeeded() {
  File f = LittleFS.open(HISTORY_FILE, FILE_READ);
  if (!f) return;

  String header = f.readStringUntil('\n');
  std::vector<String> lines;

  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();
    if (line.length()) lines.push_back(line);
  }
  f.close();

  if (lines.size() <= MAX_RECORDS) return;

  File out = LittleFS.open("/analises.tmp", FILE_WRITE);
  if (!out) return;

  header.trim();
  out.println(header);

  size_t start = lines.size() - MAX_RECORDS;
  for (size_t i = start; i < lines.size(); i++) {
    out.println(lines[i]);
  }
  out.close();

  LittleFS.remove(HISTORY_FILE);
  LittleFS.rename("/analises.tmp", HISTORY_FILE);
}

void saveAnalysis(const SoilAnalysis &a) {
  ensureHistoryFile();

  File f = LittleFS.open(HISTORY_FILE, FILE_APPEND);
  if (!f) return;

  f.printf(
    "%lu,%llu,%s,%.2f,%.2f,%.1f,%.0f,%.0f,%.1f,%.0f,%s\n",
    (unsigned long)a.id,
    (unsigned long long)a.epoch,
    a.point.c_str(),
    a.ph,
    a.ec,
    a.temperature,
    a.phosphorus,
    a.potassium,
    a.moisture,
    a.nitrogen,
    a.status.c_str()
  );
  f.close();

  trimHistoryIfNeeded();
}

void loadLastId() {
  ensureHistoryFile();
  File f = LittleFS.open(HISTORY_FILE, FILE_READ);
  if (!f) return;

  f.readStringUntil('\n'); // cabeçalho
  uint32_t last = 0;

  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();
    if (!line.length()) continue;

    int comma = line.indexOf(',');
    if (comma > 0) {
      last = (uint32_t)line.substring(0, comma).toInt();
    }
  }
  f.close();
  lastId = last;
}

bool splitCsv(const String &line, String fields[], int expectedFields) {
  int field = 0;
  int start = 0;

  for (int i = 0; i <= (int)line.length(); i++) {
    if (i == (int)line.length() || line[i] == ',') {
      if (field >= expectedFields) return false;
      fields[field++] = line.substring(start, i);
      start = i + 1;
    }
  }
  return field == expectedFields;
}

// -------------------- LCD ------------------------------------
void lcdPrintLine(uint8_t row, String text) {
  if (text.length() > LCD_COLS) text = text.substring(0, LCD_COLS);
  while (text.length() < LCD_COLS) text += " ";
  lcd.setCursor(0, row);
  lcd.print(text);
}

void updateLcd() {
  if (!hasAnalysis) {
    lcdPrintLine(0, "SOILBOX MOVETECH");
    lcdPrintLine(1, "Preparando...");
    return;
  }

  char l1[24];
  char l2[24];

  if (lcdPage == 0) {
    lcdPrintLine(0, "DESLIGUE/LIGUE");
    lcdPrintLine(1, "NOVA ANALISE");
  }
  else if (lcdPage == 1) {
    snprintf(l1, sizeof(l1), "pH %.2f", currentAnalysis.ph);
    snprintf(l2, sizeof(l2), "EC %.2f mS/cm", currentAnalysis.ec);
    lcdPrintLine(0, l1);
    lcdPrintLine(1, l2);
  }
  else if (lcdPage == 2) {
    snprintf(l1, sizeof(l1), "Temp %.1f C", currentAnalysis.temperature);
    snprintf(l2, sizeof(l2), "Umid %.1f%%", currentAnalysis.moisture);
    lcdPrintLine(0, l1);
    lcdPrintLine(1, l2);
  }
  else if (lcdPage == 3) {
    snprintf(l1, sizeof(l1), "N %.0f P %.0f", currentAnalysis.nitrogen, currentAnalysis.phosphorus);
    snprintf(l2, sizeof(l2), "K %.0f mg/kg", currentAnalysis.potassium);
    lcdPrintLine(0, l1);
    lcdPrintLine(1, l2);
  }
  else if (lcdPage == 4) {
    snprintf(l1, sizeof(l1), "Analise #%lu", (unsigned long)currentAnalysis.id);
    lcdPrintLine(0, l1);
    lcdPrintLine(1, currentAnalysis.status);
  }
  else {
    lcdPrintLine(0, "WiFi SoilBox");
    lcdPrintLine(1, WiFi.softAPIP().toString());
  }
}

// -------------------- SIMULAÇÃO -------------------------------
SoilAnalysis simulateAnalysis(String point) {
  SoilAnalysis a;

  a.id = ++lastId;
  a.epoch = currentEpoch();

  if (point.length() == 0) {
    point = "Ponto-" + String(a.id);
  }
  a.point = sanitizeCsvField(point);

  // Valores SIMULADOS.
  // Substitua essas linhas pelas leituras reais dos sensores futuramente.
  a.ph = randomFloat(4.8, 7.6, 2);
  a.ec = randomFloat(0.20, 2.20, 2);
  a.temperature = randomFloat(18.0, 32.0, 1);
  a.phosphorus = randomFloat(5.0, 65.0, 0);
  a.potassium = randomFloat(20.0, 220.0, 0);
  a.moisture = randomFloat(18.0, 75.0, 1);
  a.nitrogen = randomFloat(10.0, 100.0, 0);

  a.status = classifySoil(a);
  return a;
}

void performAnalysis(String point = "") {
  currentAnalysis = simulateAnalysis(point);
  hasAnalysis = true;
  saveAnalysis(currentAnalysis);

  lcdPage = 0;
  updateLcd();

  Serial.println();
  Serial.println("========== NOVA ANALISE ==========");
  Serial.printf("ID: %lu | Ponto: %s\n", (unsigned long)currentAnalysis.id, currentAnalysis.point.c_str());
  Serial.printf("pH: %.2f\n", currentAnalysis.ph);
  Serial.printf("EC: %.2f mS/cm\n", currentAnalysis.ec);
  Serial.printf("Temperatura: %.1f C\n", currentAnalysis.temperature);
  Serial.printf("Umidade: %.1f %%\n", currentAnalysis.moisture);
  Serial.printf("Nitrogenio: %.0f mg/kg\n", currentAnalysis.nitrogen);
  Serial.printf("Fosforo: %.0f mg/kg\n", currentAnalysis.phosphorus);
  Serial.printf("Potassio: %.0f mg/kg\n", currentAnalysis.potassium);
  Serial.printf("Status: %s\n", currentAnalysis.status.c_str());
}

// -------------------- API / SITE ------------------------------
void handleDataApi() {
  ensureHistoryFile();
  File f = LittleFS.open(HISTORY_FILE, FILE_READ);

  if (!f) {
    server.send(500, "application/json", "{\"erro\":\"falha ao abrir historico\"}");
    return;
  }

  String json = "[";
  bool first = true;

  f.readStringUntil('\n'); // cabeçalho

  while (f.available()) {
    String line = f.readStringUntil('\n');
    line.trim();
    if (!line.length()) continue;

    String v[11];
    if (!splitCsv(line, v, 11)) continue;

    if (!first) json += ",";
    first = false;

    json += "{";
    json += "\"id\":" + v[0] + ",";
    json += "\"epoch\":" + v[1] + ",";
    json += "\"point\":\"" + jsonEscape(v[2]) + "\",";
    json += "\"ph\":" + v[3] + ",";
    json += "\"ec\":" + v[4] + ",";
    json += "\"temperature\":" + v[5] + ",";
    json += "\"phosphorus\":" + v[6] + ",";
    json += "\"potassium\":" + v[7] + ",";
    json += "\"moisture\":" + v[8] + ",";
    json += "\"nitrogen\":" + v[9] + ",";
    json += "\"status\":\"" + jsonEscape(v[10]) + "\"";
    json += "}";
  }

  f.close();
  json += "]";

  server.send(200, "application/json; charset=utf-8", json);
}

void handleMetaApi() {
  String json = "{";
  json += "\"ip\":\"" + WiFi.softAPIP().toString() + "\",";
  json += "\"clients\":" + String(WiFi.softAPgetStationNum()) + ",";
  json += "\"fsUsed\":" + String((unsigned long)LittleFS.usedBytes()) + ",";
  json += "\"fsTotal\":" + String((unsigned long)LittleFS.totalBytes()) + ",";
  json += "\"freeHeap\":" + String((unsigned long)ESP.getFreeHeap()) + ",";
  json += "\"auto\":";
  json += autoMode ? "true" : "false";
  json += "}";

  server.send(200, "application/json; charset=utf-8", json);
}

void handleAnalyze() {
  server.send(
    409,
    "application/json; charset=utf-8",
    "{\"ok\":false,\"mensagem\":\"Ciclo concluido. Desligue e ligue o SoilBox para uma nova analise.\"}"
  );
}

void handleClear() {
  if (LittleFS.exists(HISTORY_FILE)) LittleFS.remove(HISTORY_FILE);
  ensureHistoryFile();

  lastId = 0;
  hasAnalysis = false;
  autoMode = false;

  lcdPage = 0;
  updateLcd();

  server.send(200, "application/json", "{\"ok\":true}");
}

void handleDownload() {
  ensureHistoryFile();
  File f = LittleFS.open(HISTORY_FILE, FILE_READ);

  if (!f) {
    server.send(404, "text/plain", "Arquivo nao encontrado.");
    return;
  }

  server.sendHeader("Content-Disposition", "attachment; filename=soilbox_movetech_analises.csv");
  server.streamFile(f, "text/csv");
  f.close();
}

void handleAuto() {
  autoMode = false;
  server.send(
    200,
    "application/json; charset=utf-8",
    "{\"auto\":false,\"mensagem\":\"Uma analise por ciclo de energia.\"}"
  );
}

void handleTimeSync() {
  if (server.hasArg("epoch")) {
    uint64_t epoch = strtoull(server.arg("epoch").c_str(), nullptr, 10);

    if (epoch > 1000000000ULL) {
      syncedEpoch = epoch;
      syncedAtMillis = millis();
    }
  }

  server.send(200, "application/json", "{\"ok\":true}");
}

void setupRoutes() {
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
  });

  server.on("/api/data", HTTP_GET, handleDataApi);
  server.on("/api/meta", HTTP_GET, handleMetaApi);
  server.on("/analisar", HTTP_GET, handleAnalyze);
  server.on("/limpar", HTTP_GET, handleClear);
  server.on("/download", HTTP_GET, handleDownload);
  server.on("/auto", HTTP_GET, handleAuto);
  server.on("/sync-time", HTTP_GET, handleTimeSync);

  server.onNotFound([]() {
    server.sendHeader("Location", "/");
    server.send(302, "text/plain", "");
  });
}


// -------------------- CICLO AUTOMÁTICO ------------------------
void waitOneSecondServingWeb() {
  unsigned long start = millis();
  while (millis() - start < 1000) {
    server.handleClient();
    delay(5);
  }
}

void runStartupAnalysisCycle() {
  // 1) Temporizador de 5 segundos ao ligar.
  for (int sec = 5; sec >= 1; sec--) {
    lcdPrintLine(0, "SOILBOX MOVETECH");
    lcdPrintLine(1, "Inicia em " + String(sec) + " s");
    Serial.printf("Inicio da analise em %d s...\n", sec);
    waitOneSecondServingWeb();
  }

  // 2) Simula a leitura dos sensores por 10 segundos.
  for (int sec = 10; sec >= 1; sec--) {
    lcdPrintLine(0, "ANALISANDO SOLO");
    lcdPrintLine(1, "Aguarde " + String(sec) + " s");
    Serial.printf("Analisando solo... %d s\n", sec);
    waitOneSecondServingWeb();
  }

  // 3) Gera e salva UMA análise simulada.
  performAnalysis();
  cycleCompleted = true;

  lcdPrintLine(0, "ANALISE PRONTA!");
  lcdPrintLine(1, "Dados salvos");
  Serial.println("Analise concluida. Desligue e ligue para analisar novamente.");
  waitOneSecondServingWeb();
  waitOneSecondServingWeb();

  lcdPage = 0;
  lastLcdPageChange = millis();
  updateLcd();
}

// -------------------- SETUP ----------------------------------
void setup() {
  Serial.begin(115200);
  delay(300);

  randomSeed(esp_random());

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  Wire.begin(SDA_PIN, SCL_PIN);

  lcd.begin(LCD_COLS, LCD_ROWS, Wire);
  lcd.setBacklight(255);
  lcd.clear();
  lcdPrintLine(0, "SOILBOX MOVETECH");
  lcdPrintLine(1, "Inicializando...");

  if (!LittleFS.begin(true)) {
    lcdPrintLine(0, "Erro na Flash!");
    lcdPrintLine(1, "Verifique ESP32");
    Serial.println("ERRO: LittleFS nao iniciou.");
  } else {
    ensureHistoryFile();
    loadLastId();
  }

  WiFi.mode(WIFI_AP);

  // IP fixo para facilitar a apresentação.
  IPAddress localIP(192, 168, 4, 1);
  IPAddress gateway(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.softAPConfig(localIP, gateway, subnet);

  bool apOk = WiFi.softAP(WIFI_SSID, WIFI_PASSWORD);

  if (!apOk) {
    Serial.println("ERRO ao criar Wi-Fi.");
    lcdPrintLine(0, "Erro no WiFi!");
    lcdPrintLine(1, "Reinicie ESP32");
  } else {
    Serial.println("Wi-Fi criado com sucesso.");
    Serial.print("Rede: ");
    Serial.println(WIFI_SSID);
    Serial.print("IP: ");
    Serial.println(WiFi.softAPIP());
  }

  setupRoutes();
  server.begin();

  lcdPrintLine(0, "SOILBOX MOVETECH");
  lcdPrintLine(1, "Sistema pronto");

  // Uma única análise por vez que o ESP32 é ligado/reiniciado.
  runStartupAnalysisCycle();
}

// -------------------- LOOP -----------------------------------
void loop() {
  server.handleClient();

  // Após concluir a análise, alterna a instrução e os resultados.
  // Só haverá outra análise quando o ESP32 for reiniciado.
  if (cycleCompleted && millis() - lastLcdPageChange >= 2500) {
    lastLcdPageChange = millis();
    lcdPage = (lcdPage + 1) % 6;
    updateLcd();
  }

  delay(2);
}
