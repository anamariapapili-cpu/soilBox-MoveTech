<script>
let analyses = [];
let meta = {};
let isBusy = false;

const metricInfo = {
  ph:{label:"pH",unit:""},
  ec:{label:"Condutividade",unit:"mS/cm"},
  temperature:{label:"Temperatura",unit:"°C"},
  moisture:{label:"Umidade",unit:"%"},
  nitrogen:{label:"Nitrogênio",unit:"mg/kg"},
  phosphorus:{label:"Fósforo",unit:"mg/kg"},
  potassium:{label:"Potássio",unit:"mg/kg"}
};

async function syncClock(){
  try{
    const epoch = Math.floor(Date.now()/1000);
    await fetch("/sync-time?epoch="+epoch,{cache:"no-store"});
  }catch(e){}
}

async function loadAll(){
  try{
    const [dataResp,metaResp] = await Promise.all([
      fetch("/api/data",{cache:"no-store"}),
      fetch("/api/meta",{cache:"no-store"})
    ]);
    analyses = await dataResp.json();
    meta = await metaResp.json();
    updateUi();
  }catch(e){
    console.log(e);
  }
}

function fmt(v,d=1){
  return (v===undefined || v===null) ? "--" : Number(v).toFixed(d);
}

function formatTime(epoch){
  if(!epoch) return "sem data";
  return new Date(epoch*1000).toLocaleString("pt-BR");
}

function updateUi(){
  const a = analyses.length ? analyses[analyses.length-1] : null;

  if(a){
    document.getElementById("ph").textContent = fmt(a.ph,2);
    document.getElementById("ec").textContent = fmt(a.ec,2);
    document.getElementById("temp").textContent = fmt(a.temperature,1);
    document.getElementById("moist").textContent = fmt(a.moisture,1);
    document.getElementById("n").textContent = fmt(a.nitrogen,0);
    document.getElementById("p").textContent = fmt(a.phosphorus,0);
    document.getElementById("k").textContent = fmt(a.potassium,0);

    const pill = document.getElementById("statusPill");
    pill.textContent = a.status;
    pill.className = "status-pill " + statusClass(a.status);
    document.getElementById("recommendation").textContent = recommendation(a);
  }

  const body = document.getElementById("historyBody");
  if(!analyses.length){
    body.innerHTML = '<tr><td colspan="11" class="empty">Nenhuma análise salva.</td></tr>';
  }else{
    body.innerHTML = analyses.slice().reverse().map(a=>`
      <tr>
        <td>${a.id}</td>
        <td>${formatTime(a.epoch)}</td>
        <td>${escapeHtml(a.point)}</td>
        <td>${fmt(a.ph,2)}</td>
        <td>${fmt(a.ec,2)}</td>
        <td>${fmt(a.temperature,1)}</td>
        <td>${fmt(a.moisture,1)}</td>
        <td>${fmt(a.nitrogen,0)}</td>
        <td>${fmt(a.phosphorus,0)}</td>
        <td>${fmt(a.potassium,0)}</td>
        <td><b>${a.status}</b></td>
      </tr>
    `).join("");
  }

  document.getElementById("ipInfo").textContent = "IP: " + (meta.ip || "--");
  document.getElementById("clientsInfo").textContent = "Dispositivos conectados: " + (meta.clients ?? "--");
  document.getElementById("flashInfo").textContent =
    `Flash: ${formatBytes(meta.fsUsed||0)} / ${formatBytes(meta.fsTotal||0)}`;
  document.getElementById("heapInfo").textContent =
    "RAM livre: " + formatBytes(meta.freeHeap||0);

  const autoBtn = document.getElementById("autoBtn");
  autoBtn.textContent = "Modo automático: " + (meta.auto ? "ON" : "OFF");

  drawChart();
}

function statusClass(s){
  if(s==="Favorável") return "good";
  if(s==="Desfavorável") return "bad";
  return "warn";
}

function recommendation(a){
  const tips=[];
  if(a.ph < 5.5) tips.push("verificar acidez do solo");
  if(a.ph > 7.2) tips.push("verificar alcalinidade");
  if(a.moisture < 30) tips.push("avaliar irrigação e cobertura do solo");
  if(a.moisture > 65) tips.push("avaliar drenagem");
  if(a.ec > 1.8) tips.push("investigar possível excesso de sais");
  if(a.nitrogen < 25) tips.push("avaliar reposição de matéria orgânica/nitrogênio");
  if(a.phosphorus < 12) tips.push("avaliar disponibilidade de fósforo");
  if(a.potassium < 45) tips.push("avaliar disponibilidade de potássio");

  if(!tips.length) return "Os parâmetros simulados estão dentro das faixas demonstrativas configuradas.";
  return "Sugestões: " + tips.join("; ") + ".";
}

function escapeHtml(s){
  return String(s||"").replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
  }[c]));
}

function formatBytes(n){
  n=Number(n)||0;
  if(n<1024) return n+" B";
  if(n<1024*1024) return (n/1024).toFixed(1)+" KB";
  return (n/1024/1024).toFixed(2)+" MB";
}

