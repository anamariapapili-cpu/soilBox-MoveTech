function drawChart(){
  const canvas=document.getElementById("chart");
  const rect=canvas.getBoundingClientRect();
  const dpr=window.devicePixelRatio||1;
  canvas.width=Math.max(300,Math.floor(rect.width*dpr));
  canvas.height=Math.max(220,Math.floor(rect.height*dpr));
  const ctx=canvas.getContext("2d");
  ctx.scale(dpr,dpr);

  const W=rect.width,H=rect.height;
  ctx.clearRect(0,0,W,H);

  const key=document.getElementById("metricSelect").value;
  const info=metricInfo[key];

  ctx.fillStyle="#66766f";
  ctx.font="12px Arial";
  ctx.fillText(info.label + (info.unit ? " ("+info.unit+")" : ""),16,18);

  if(analyses.length<1){
    ctx.fillText("Faça uma análise para iniciar o gráfico.",16,48);
    return;
  }

  const vals=analyses.map(a=>Number(a[key]));
  let min=Math.min(...vals), max=Math.max(...vals);
  if(min===max){min-=1;max+=1;}
  const pad=(max-min)*0.15 || 1;
  min-=pad; max+=pad;

  const left=48,right=18,top=34,bottom=38;
  const plotW=W-left-right,plotH=H-top-bottom;

  ctx.strokeStyle="#dce6e1";
  ctx.lineWidth=1;
  ctx.fillStyle="#66766f";
  ctx.font="11px Arial";

  for(let i=0;i<=4;i++){
    const y=top+(plotH*i/4);
    ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(W-right,y);ctx.stroke();
    const value=max-(max-min)*i/4;
    ctx.fillText(value.toFixed(key==="ph"||key==="ec"?2:1),4,y+4);
  }

  const stepX=analyses.length===1 ? 0 : plotW/(analyses.length-1);

  ctx.strokeStyle="#1f7a4c";
  ctx.lineWidth=2.5;
  ctx.beginPath();
  vals.forEach((v,i)=>{
    const x=left+(analyses.length===1?plotW/2:i*stepX);
    const y=top+(max-v)/(max-min)*plotH;
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  });
  ctx.stroke();

  vals.forEach((v,i)=>{
    const x=left+(analyses.length===1?plotW/2:i*stepX);
    const y=top+(max-v)/(max-min)*plotH;
    ctx.fillStyle="#1f7a4c";
    ctx.beginPath();ctx.arc(x,y,3.5,0,Math.PI*2);ctx.fill();
  });

  ctx.fillStyle="#66766f";
  const maxLabels=Math.min(8,analyses.length);
  for(let j=0;j<maxLabels;j++){
    const idx=Math.round(j*(analyses.length-1)/Math.max(1,maxLabels-1));
    const x=left+(analyses.length===1?plotW/2:idx*stepX);
    ctx.fillText("#"+analyses[idx].id,Math.max(2,x-8),H-14);
  }
}

window.addEventListener("resize",drawChart);

(async()=>{
  await syncClock();
  await loadAll();

  setInterval(loadAll,4000);
})();
</script>
